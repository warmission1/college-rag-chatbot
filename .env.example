# ==============================================================================
# RAG AI College Chatbot - Environment Configuration
# ==============================================================================

# Application & Security
PROJECT_NAME="College RAG Assistant"
ENVIRONMENT="development"
DEBUG=True
AUTH_SECRET=""
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ==============================================================================
# MongoDB Cloud Database & Cloud File Storage
# ==============================================================================
DATABASE_TYPE="mongodb"
STORAGE_TYPE="mongodb"

# Enter your MongoDB connection URI here:
MONGODB_URI=""
MONGODB_DB_NAME=""

# ==============================================================================
# AI Provider Configuration (LLM & Embeddings)
# ==============================================================================

# LLM Provider ("openai", "gemini", or "mock")
LLM_PROVIDER=""
LLM_API_KEY=""
LLM_MODEL=""

# Embedding Provider ("openai", "gemini", or "mock")
EMBEDDING_PROVIDER=""
EMBEDDING_API_KEY=""
EMBEDDING_MODEL=""
EMBEDDING_DIMENSIONS=384

# ==============================================================================
# RAG Retrieval Settings
# ==============================================================================
RAG_TOP_K=20
RAG_CONTEXT_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_CONTEXT_TOKENS=6000
RAG_MAX_HISTORY_MESSAGES=8
HYBRID_SEARCH_ENABLED=True
RERANKER_ENABLED=False
OCR_ENABLED=False
UPLOAD_MAX_MB=50
